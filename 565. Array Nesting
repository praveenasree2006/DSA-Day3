class Solution {
    public int arrayNesting(int[] nums) {
        int maxLength=0;
        for(int i=0;i<nums.length;i++){
            //skip if already processed
            if(nums[i]==Integer.MIN_VALUE) continue;

            int index=i;
            int length=0;
            while(true){
                if(nums[index]==Integer.MIN_VALUE) break;

                int newIndex=nums[index];
                nums[index]=Integer.MIN_VALUE;
                length++;
                index=newIndex;
            }

            maxLength=Math.max(maxLength,length);
        }

        return maxLength;
    }
}
